#!/usr/bin/perl

use strict;
use DBI;
use Getopt::Long;
use Image::ExifTool 'ImageInfo';
use Image::Magick;
use Pod::Usage;
use Rings::Common;

my $opt_confirm;
my $opt_debug;
my $opt_end;
my $opt_help;
my $opt_lot;
my $opt_manual;
my $opt_progress;
my $opt_start;

##############################################################################
# Subroutines
##############################################################################

# ------------------------------------------------
# Prepare an image to generate ahash and bhash
sub prepare_image {
    my ($filename, $width, $height) = @_;

    my $img = Image::Magick->new;
    my $err = $img->Read($filename);
    die "Cannot read $filename: $err" if $err;

    $img->AutoOrient();

    $img->Resize(width => $width, height => $height);

    # Convert to grayscale
    $img->Set(colorspace => 'Gray');

    return $img;
}

# ------------------------------------------------
# Generater an a hash given a file name

sub ahash {
    my ($filename) = @_;

    my $img = prepare_image($filename, 8, 8);

    my @pixels;

    for my $y (0 .. 7) {
        for my $x (0 .. 7) {
            my @p = $img->GetPixel(x => $x, y => $y);
            push @pixels, $p[0];
        }
    }

    my $average = 0;
    $average += $_ for @pixels;
    $average /= @pixels;

    my $hash = 0;

    for my $p (@pixels) {
        $hash <<= 1;
        $hash |= ($p >= $average) ? 1 : 0;
    }

    return sprintf("%016x", $hash);
}
# ------------------------------------------------
# Generate a dhash given a filename

sub dhash {
    my ($filename) = @_;

    my $img = prepare_image($filename, 9, 8);

    my $hash = 0;

    for my $y (0 .. 7) {
        for my $x (0 .. 7) {

            my @p1 = $img->GetPixel(x => $x,     y => $y);
            my @p2 = $img->GetPixel(x => $x + 1, y => $y);

            $hash <<= 1;
            $hash |= ($p1[0] > $p2[0]) ? 1 : 0;
        }
    }

    return sprintf("%016x", $hash);
}

# ------------------------------------------------
# set the raw signature given a pid and the signature

sub set_raw_signature {
    my ($pid, $sig) = @_;

    my $sql = 'UPDATE pictures_information SET';
    $sql .= ' raw_signature = ?';
    $sql .= ' WHERE pid = ?';
    if ($opt_confirm) {
        my $sth = $DBH->prepare($sql);
        $sth->execute($sig, $pid);
        if ($sth->err) {
            sql_die($sql, $sth->err, $sth->errstr);
        }
    } else {
        msg(
            'PROPOSING',
            "$pid to set raw_signature"
        );
    }
    return;
}

# ------------------------------------------------
# process the files

sub read_and_update {
    my ($pid) = @_;

    my $sel = 'SELECT picture_lot, ';
    $sel .= ', file_name';
    $sel .= ', raw_signature';
    $sel .= ', source_file';
    $sel .= ' FROM pictures_information';
    $sel .= ' WHERE pid = ?';

    if ($opt_debug) {
        dbg($sel);
    }

    my $sth = $DBH->prepare($sel);
    $sth->execute($pid);
    if ($sth->err) {
        sql_die($sel, $sth->err, $sth->errstr);
    }
    while (my $row = $sth->fetchrow_hashref) {
        my $lot      = $row->{picture_lot};
        my $file     = $row->{file_name};
        my $raw_sig  = $row->{raw_signature};
        my $src_path = $row->{source_file};

        # source file test
        my $db_path = $CONF->picture_input_root . "/$lot/$file";
        if ($src_path ne $db_path) {
            msg('warn', "$pid source file mismatch");
            msg('warn', "  src path: $src_path");
            msg('warn', "   db path: $db_path");
        } else {
            msg('info', "$pid source file matches input file");
        }
        my $src_sig;
        if (-e $src_path) {
            my $src_sig = get_signature($src_path);
            msg('info', "Source file found: $src_path");
        } else {
            msg('warn', "$pid input file found: $src_path");
        }
        my $db_sig;
        if (-e $db_path) {
            $db_sig = get_signature($db_path);
            msg('info', "DB file found $db_path");
        } else {
            msg('warn', "$pid database file not found $db_path");
        }

        # signature set
        if ($raw_sig eq $db_sig && $db_sig eq $src_sig) {
            # If both signatures from both files are found and they
            # match the database then no signature updates are
            #  required.
            msg('info', "$pid signture OKAY");
        } elsif ($src_sig) {
            msg('info', "$pid Input file exists");
            if ($src_sig eq $db_sig && $raw_sig ne $src_sig) {
                # if the signatures from the files match and the raw
                # signature differs then set the raw signature to
                # match the files.
                msg('info', "$pid File signatures match, db to be updated");
                set_raw_signature($pid, $db_sig);
            } else {
                # If the signature from the source signature exists then
                # the ring entry has a path to the ring input image.
                # In this case the ring entry should be copied into
                # the ring image directory, the raw signature should
                # be set to the signature from the input image, and
                # a 'SIZE' action should be queued just to be sure
                # everything matches.
                msg('info', "$pid Copying $src_path to $db_path");
                if (!File::Copy::syscopy($src_path, $db_path)) {
                    my $m = "Problem copying $src_path to $db_path, $!";
                    msg('fatal', $m);
                }
                msg('info', "$pid Setting raw signature");
                set_raw_signature($pid, $src_sig);
                msg('info', "$pid Queueing an image SIZE action");
                if ($opt_confirm) {
                    queue_action_set($pid, 'SIZE');
                } else {
                    msg('PROPOSING', "$pid queue SIZE action");
                }
            }
        } elsif ($raw_sig ne $db_sig) {
            # If the raw signature does not match the the ring file
            # signature then set the raw signature to the signature
            # from the file.
            msg('info', "$pid Setting raw signature");
            set_raw_signature($pid, $db_sig);
        } else {
            msg('WARN', "$pid signature problem requires manual resolution");
        }
    }

    return;
}

##############################################################################
# Main Routine
##############################################################################

print ">>> ring-set-info\n";

# -- get options
GetOptions(
    'confirm'    => \$opt_confirm,
    'debug'      => \$opt_debug,
    'end=i'      => \$opt_end,
    'help'       => \$opt_help,
    'lot=s'      => \$opt_lot,
    'manual'     => \$opt_manual,
    'progress=i' => \$opt_progress,
    'start=i'    => \$opt_start
);

# help the poor souls out
if ($opt_help) {
    pod2usage(-verbose => 0);
}
if ($opt_manual) {
    pod2usage(-verbose => 2);
}

my @pid_list = get_pid_list($opt_lot, $opt_start, $opt_end);

# Validate input
#  If a start is given there must be an end
#  At least a start-end or lot must be given
if (!$opt_end && !$opt_start && !$opt_lot) {
    print("ERROR: start-end or lot must be specified\n");
    pod2usage(-verbose => 0);
}
if (($opt_start && !$opt_end) || (!$opt_start && $opt_end)) {
    print("ERROR: both start and end must be specified\n");
    pod2usage(-verbose => 0);
}

my $id      = shift;
my %id_list = get_id_list();
if (!$id_list{$id}) {
    print("ERROR: unknown ID $id\n");
    print("INFO: Valid IDs:\n");
    for my $i (sort keys %id_list) {
        print("    $i\n");
    }
    exit 1;
}

my $ring_conf = "/etc/rings/${id}.conf";
if ($opt_debug) {
    print("ring_conf = $ring_conf\n");
}
get_config($ring_conf);
if ($opt_debug) {
    $CONF->debug($opt_debug);
}

if ($opt_debug) {
    $CONF->debug($opt_debug);
}
if ($CONF->debug) {
    dbg("Initialize timer.");
}

db_connect();

my $cnt          = 0;
my $cnt_progress = 0;
for my $pid (@pid_list) {
    $cnt++;
    if ($cnt_progress > $opt_progress) {
        msg('info', $cnt);
        $cnt_progress = 0;
    }
    $cnt_progress++;
    print("\n");
    print("Processing picture $pid\n");
    read_and_update($pid);
}

exit;

__END__

=head1 NAME

ring-set-info - set picture information from the raw picture

=head1 SYNOPSIS

ring-set-info --start=<int> --id=<ring id> [--end=<int>] [--update]
[--progress=int] [--signature] [--debug] [--help] [--manual]


=head1 DESCRIPTION

Set information from the raw picture.

=head1 OPTIONS AND ARGUMENTS

=over 4

=item --id=<ring id>

The ring id to process.  Required.

=item --start=int

The picture id to start processing pictures_information entries.
Required.

=item --end=int

The picture id to end processing pictures_informatation entries.
If not specified then set the ending picture id to the starting
picture id.

=item --progress=<int>

Display progress every <int> entries processed.

=item --signature

Update raw_signatures in the database that do not match the values
derived from the files.

=item --update

Actually load the data into the rings database.

=item --help

Displays help text.

=item --manual

Displays more complete help text.

=item --debug

Turns on debugging displays.

=back

=head1 AUTHOR

Bill MacAllister <bill@macallister.grass-valley.ca.us>

=cut
