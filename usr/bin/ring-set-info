#!/usr/bin/perl

use strict;
use DBI;
use File::Copy;
use Getopt::Long;
use Image::ExifTool 'ImageInfo';
use Image::Magick;
use Pod::Usage;
use Rings::Common;

my $opt_confirm;
my $opt_debug;
my $opt_end;
my $opt_findlot;
my $opt_help;
my $opt_id;
my $opt_lot;
my $opt_manual;
my $opt_progress = 5;
my $opt_start;

##############################################################################
# Subroutines
##############################################################################

# ------------------------------------------------
# return regex target string with all files types supported

sub get_file_regex {
    my $type_list = '';
    my $or        = '(';
    my @types     = get_ring_types();
    for my $t (@types) {
        $type_list .= $or . $t;
        $or = '|';
    }
    if ($or eq '|') {
        $type_list .= ')';
    }
    return $type_list;
}

# ------------------------------------------------
# return a file from a list of supported types

sub get_file_path {
    my ($path)    = @_;
    my $type_list = get_file_regex();
    my $glob_path = "$path*";
    my @file_list = glob($glob_path);
    for my $f (@file_list) {
        if ($f =~ /[.]$type_list$/xmsi) {
            return $f;
        }
    }
    return;
}

# ------------------------------------------------
# Display the lots in the rings database

sub show_pid_list {
    my ($lot) = @_;
    my $sel = 'SELECT DISTINCT picture_lot FROM pictures_information ';
    my $sth;
    if ($lot) {
        $sel .= 'WHERE picture_lot like "%' . $lot . '%"';
    }
    dbg($sel) if $CONF->debug;
    $sth = $DBH->prepare($sel);
    $sth->execute();
    if ($sth->err) {
        sql_die($sel, $sth->err, $sth->errstr);
    }
    while (my $row = $sth->fetchrow_hashref('NAME_lc')) {
        print('  ' . $row->{picture_lot} . "\n");
    }
    return;
}

# ------------------------------------------------
# Prepare an image to generate ahash and bhash
sub prepare_image {
    my ($filename, $width, $height) = @_;

    my $img = Image::Magick->new;
    my $err = $img->Read($filename);
    die "Cannot read $filename: $err" if $err;

    $img->AutoOrient();

    $img->Resize(width => $width, height => $height);

    # Convert to grayscale
    $img->Set(colorspace => 'Gray');

    return $img;
}

# ------------------------------------------------
# Generater an a hash given a file name

sub ahash {
    my ($filename) = @_;

    my $img = prepare_image($filename, 8, 8);

    my @pixels;

    for my $y (0 .. 7) {
        for my $x (0 .. 7) {
            my @p = $img->GetPixel(x => $x, y => $y);
            push @pixels, $p[0];
        }
    }

    my $average = 0;
    $average += $_ for @pixels;
    $average /= @pixels;

    my $hash = 0;

    for my $p (@pixels) {
        $hash <<= 1;
        $hash |= ($p >= $average) ? 1 : 0;
    }

    return sprintf("%016x", $hash);
}
# ------------------------------------------------
# Generate a dhash given a filename

sub dhash {
    my ($filename) = @_;

    my $img = prepare_image($filename, 9, 8);

    my $hash = 0;

    for my $y (0 .. 7) {
        for my $x (0 .. 7) {

            my @p1 = $img->GetPixel(x => $x,     y => $y);
            my @p2 = $img->GetPixel(x => $x + 1, y => $y);

            $hash <<= 1;
            $hash |= ($p1[0] > $p2[0]) ? 1 : 0;
        }
    }

    return sprintf("%016x", $hash);
}

# ------------------------------------------------
# set the raw signature given a pid and the signature

sub set_db_signature {
    my ($pid, $sig) = @_;

    my $sql = 'UPDATE pictures_information SET';
    $sql .= ' raw_signature = ?';
    $sql .= ' WHERE pid = ?';
    if ($opt_confirm) {
        my $sth = $DBH->prepare($sql);
        $sth->execute($sig, $pid);
        if ($sth->err) {
            sql_die($sql, $sth->err, $sth->errstr);
        }
    } else {
        msg(
            'PROPOSING',
            "$pid to set raw_signature"
        );
    }
    return;
}

# ------------------------------------------------
# process the files

sub read_and_update {
    my ($pid) = @_;

    my $type_list = get_file_regex();

    my $sel = 'SELECT picture_lot';
    $sel .= ', file_name';
    $sel .= ', raw_signature';
    $sel .= ', source_file';
    $sel .= ' FROM pictures_information';
    $sel .= ' WHERE pid = ?';

    if ($opt_debug) {
        dbg($sel);
    }

    my $sth = $DBH->prepare($sel);
    $sth->execute($pid);
    if ($sth->err) {
        sql_die($sel, $sth->err, $sth->errstr);
    }
    while (my $row = $sth->fetchrow_hashref) {
        my $db_lot     = $row->{picture_lot};
        my $db_file    = $row->{file_name};
        my $db_sig     = $row->{raw_signature};
        my $db_in_path = $row->{source_file};

        my $ring_sig;
        my $raw_root  = $CONF->picture_root . "/$db_lot/raw/$pid";
        my $ring_path = get_file_path($raw_root);
        if (-e $ring_path) {
            $ring_sig = image_signature($ring_path);
            msg('okay', "$pid ring file found ($ring_path)");
        } else {
            msg('info', "$pid ring root ($raw_root)");
            msg('warn', "$pid ring file not found ($ring_path)");
        }

        # db file paths test
        my $db_in_dir       = $CONF->picture_input_root . "/$db_lot";
        my $db_in_file_path = "$db_in_dir/$db_file";
        if ($db_in_file_path ne $db_in_path) {
            msg('warn', "$pid db file paths mismatch");
            msg('info', "$pid  db in file path: $db_in_file_path");
            msg('info', "$pid       db in path: $db_in_path");
        } else {
            msg('okay', "$pid db file paths consistent");
        }

        my $in_sig;
        if (-e $db_in_path) {
            $in_sig = image_signature($db_in_path);
            msg('okay', "$pid DB in file found: $db_in_path");
        } else {
            msg('warn', "$pid DB in file not found: $db_in_path");
            if (-e $db_in_dir) {
                msg('info', "$pid in lot directory found: $db_in_dir");
            } else {
                msg(
                    'info',
                    "$pid in lot directory not found: $db_in_dir"
                );
            }
        }

        # signature tests
        if ($db_sig eq $in_sig && $in_sig eq $ring_sig) {
            # If both signatures from both files are found and they
            # match the database then no signature updates are
            #  required.
            msg('okay', "$pid files and DB signtures match");
        } elsif ($in_sig) {
            if ($in_sig ne $db_sig) {
                msg('warn', "$pid input/database signature mismatch");
                msg('info', "  in_sig: ($in_sig)");
                msg('info', "  db_sig: ($db_sig)");
            } elsif ($in_sig ne $ring_sig) {
                msg('warn', "$pid ring/database signature mismatch");
                msg('info', "  in_sig: ($in_sig)");
                msg('info', "ring_sig: ($ring_sig)");
            } else {
                msg('warn', "$pid signature mispatch");
                msg('info', "  in_sig: ($in_sig)");
                msg('info', "  db_sig: ($db_sig)");
                msg('info', "ring_sig: ($ring_sig)");
            }
            if ($in_sig eq $ring_sig && $db_sig ne $ring_sig) {
                # if the signatures from the files match and the db
                # signature differs then set the db signature to
                # match the files.
                msg(
                    'info',
                    "$pid File signatures match, db to be updated"
                );
                if ($opt_confirm) {
                    msg('update', "$pid Setting db signature from files");
                    set_db_signature($pid, $in_sig);
                } else {
                    msg('propose', "$pid set db signature from files");
                }
            } else {
                # The input file is linked to the db entry, but
                # there is a signature mis-match.  In this case the
                # input file is taken as the source of truth.  The
                # input process should be reproduced.
                if ($opt_confirm) {
                    msg('info', "$pid Copying $db_in_path to $ring_path");
                    if (!File::Copy::syscopy($db_in_path, $ring_path)) {
                        my $m = "copy of $db_in_path to $ring_path, $!";
                        msg('fatal', $m);
                    }
                    msg('info', "$pid Setting raw signature");
                    set_db_signature($pid, $in_sig);
                    msg('info', "$pid Queueing an image SIZE action");
                    queue_action_set($pid, 'SIZE');
                } else {
                    msg('propose', "$pid process input file $db_in_path");
                }
            }
        } elsif ($db_sig ne $in_sig) {
            msg('info', 'Database signature - Input signature mismatch');
            msg('info', "  in_sig: $in_sig");
            msg('info', "  db_sig: $db_sig");
            # If the db signature does not match the the ring file
            # signature then set the db signature to the signature
            # from the file.
            if ($opt_confirm) {
                msg('info', "$pid Set db signature from input file");
                set_db_signature($pid, $in_sig);
            } else {
                msg('propose', "$pid Set db signature from input file");
            }
        } else {
            msg(
                'warn',
                "$pid signature problem requires manual resolution"
            );
            msg('info', "  in_sig: $in_sig");
            msg('info', "  db_sig: $db_sig");
            msg('info', "ring_sig: $ring_sig");
        }
    }

    return;
}

##############################################################################
# Main Routine
##############################################################################

print ">>> ring-set-info\n";

# -- get options
GetOptions(
    'confirm'    => \$opt_confirm,
    'debug'      => \$opt_debug,
    'end=i'      => \$opt_end,
    'findlot'    => \$opt_findlot,
    'help'       => \$opt_help,
    'id=s'       => \$opt_id,
    'lot=s'      => \$opt_lot,
    'manual'     => \$opt_manual,
    'progress=i' => \$opt_progress,
    'start=i'    => \$opt_start
);

# help the poor souls out
if ($opt_help) {
    pod2usage(-verbose => 0);
}
if ($opt_manual) {
    pod2usage(-verbose => 2);
}

my $id = '';
if ($opt_id) {
    $id = $opt_id;
} elsif (scalar(@ARGV) > 0) {
    $id = shift;
}
my %id_list = get_id_list();
if (!$id_list{$id}) {
    print("ERROR: unknown ID $id\n");
    print("INFO: Valid IDs:\n");
    for my $i (sort keys %id_list) {
        print("    $i\n");
    }
    exit 1;
}

my $ring_conf = "/etc/rings/${id}.conf";
if ($opt_debug) {
    print("ring_conf = $ring_conf\n");
}
get_config($ring_conf);
if ($opt_debug) {
    $CONF->debug($opt_debug);
}
if ($CONF->debug) {
    dbg("Initialize timer.");
}

db_connect();

if ($opt_findlot) {
    show_pid_list($opt_lot);
    exit;
}

# Validate input
#  If a start is given there must be an end
#  At least a start-end or lot must be given
if (!$opt_end && !$opt_start && !$opt_lot) {
    print("ERROR: start-end or lot must be specified\n");
    pod2usage(-verbose => 0);
}
if (($opt_start && !$opt_end) || (!$opt_start && $opt_end)) {
    print("ERROR: both start and end must be specified\n");
    pod2usage(-verbose => 0);
}

my @pid_list     = get_pid_list($opt_lot, $opt_start, $opt_end);
my $cnt          = 0;
my $cnt_progress = 0;
my $cnt_total    = scalar(@pid_list);
for my $pid (@pid_list) {
    if ($cnt_progress >= $opt_progress) {
        print("\n");
        msg('info', "Progress: $cnt/$cnt_total");
        $cnt_progress = 0;
    }
    $cnt++;
    $cnt_progress++;
    print("\n");
    print("Processing picture $pid\n");
    read_and_update($pid);
}

exit;

__END__

=head1 NAME

ring-set-info - set picture information from the raw picture

=head1 SYNOPSIS

ring-set-info [<ring_id>] [--id=<ring id>] [--start=<int>]
[--end=<int>] [--update] [--progress=int] [--signature] [--debug]
[--help] [--manual]


=head1 DESCRIPTION

Set information from the raw picture.

=head1 OPTIONS AND ARGUMENTS

=over 4

=item --id=<ring id>

The ring id to process.  Required if the ring identifier is not
specified as the first argument on the command line.

=item --start=int

The picture id to start processing pictures_information entries.
Required.

=item --end=int

The picture id to end processing pictures_informatation entries.
If not specified then set the ending picture id to the starting
picture id.

=item --lot=<picture lot>

The lot for the picture to be examined for duplicates.

=item --findlot

Display the ring lots in the database.

=item --progress=<int>

Display progress every <int> entries processed.

=item --signature

Update raw_signatures in the database that do not match the values
derived from the files.

=item --update

Actually load the data into the rings database.

=item --help

Displays help text.

=item --manual

Displays more complete help text.

=item --debug

Turns on debugging displays.

=back

=head1 AUTHOR

Bill MacAllister <bill@macallister.grass-valley.ca.us>

=cut
