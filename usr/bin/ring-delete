#!/usr/bin/perl
#
# Copyright (c) 2024-2026, Bill MacAllister <bill@ca-zephyr.org>
# File: ring-delete
# Description: Bulk delete pictures from the rings

use strict;
use DBI;
use Getopt::Long;
use File::Find;
use Pod::Usage;
use Rings::Common;

my $opt_confirm;
my $opt_debug;
my $opt_end;
my $opt_help;
my $opt_lot;
my $opt_manual;
my $opt_start;

# ------------------------------------------------------------------------
# -- Get a list of PIDs given a combination of a start pid, an end pid,
#    and a picture_lot.

sub get_pid_list {
    my @pid_list = ();

    my $sel = 'SELECT pid FROM pictures_information ';
    my $sth;
    if ($opt_start && $opt_lot) {
        $sel .= 'WHERE pid>=? AND pid<=? AND picture_lot=? ';
        dbg($sel) if $CONF->debug;
        $sth = $DBH->prepare($sel);
        $sth->execute($opt_start, $opt_end, $opt_lot);
    } elsif ($opt_start) {
        $sel .= 'WHERE pid>=? AND pid<=? ';
        dbg($sel) if $CONF->debug;
        $sth = $DBH->prepare($sel);
        $sth->execute($opt_start, $opt_end);
    } elsif ($opt_lot) {
        $sel .= 'WHERE picture_lot=? ';
        dbg($sel) if $CONF->debug;
        $sth = $DBH->prepare($sel);
        $sth->execute($opt_lot);
    } else {
        msg('fatal', 'Invalid selection for deletion');
    }
    if ($sth->err) {
        msg(
            'info',
            "--start=$opt_start, --opt_end=$opt_end --opt_lot=$opt_lot"
        );
        sql_die($sel, $sth->err, $sth->errstr);
    }

    while (my $row = $sth->fetchrow_hashref('NAME_lc')) {
        push @pid_list, $row->{pid};
    }
    return @pid_list;
}

# ------------------------------------------------------------------------
# -- Delete Picture files

sub ring_delete_picture {
    my ($pid) = @_;

    my $sel = 'SELECT pictures_information.picture_lot, ';
    $sel .= 'picture_sizes.size_id ';
    $sel .= 'FROM pictures_information ';
    $sel .= 'JOIN picture_sizes ';
    $sel .= 'WHERE pictures_information.pid = ? ';

    if ($CONF->debug) {
        dbg($sel);
    }

    my $sth = $DBH->prepare($sel);
    $sth->execute($pid);
    if ($sth->err) {
        print("INFO: pid = $pid");
        sql_die($sel, $sth->err, $sth->errstr);
    }
    while (my $row = $sth->fetchrow_hashref) {
        my $pic_lot  = $row->{picture_lot};
        my $size_id  = $row->{size_id};
        my $pic_path = $CONF->picture_root . "/$pic_lot/$size_id/$pid/*";
        my @pic_list = glob($pic_path);
        for my $pic (@pic_list) {
            if (-e $pic) {
                if ($opt_confirm) {
                    unlink($pic)
                      or die("ERROR: problem deleting file $pic");
                } else {
                    print("PROPOSING: file delete $pic\n");
                }
            } else {
                dbg("$pic not found to delete\n");
            }
        }
    }

    return;
}

# ------------------------------------------------------------------------
# -- Delete Picture meta data

sub db_delete_picture {
    my ($pid) = @_;

    my @del_tables = ();
    push @del_tables, 'picture_comments_grades';
    push @del_tables, 'picture_details';
    push @del_tables, 'picture_grades';
    push @del_tables, 'picture_rings';
    push @del_tables, 'pictures_information';

    for my $this_table (sort @del_tables) {
        my $sel = "SELECT count(*) as cnt FROM $this_table WHERE pid = ?";
        dbg($sel) if $CONF->debug;
        my $sth = $DBH->prepare($sel);
        $sth->execute($pid);
        if ($sth->err) {
            print("INFO: pid = $pid");
            sql_die($sel, $sth->err, $sth->errstr);
        }
        my $cnt = 0;
        while (my $row = $sth->fetchrow_hashref('NAME_lc')) {
            $cnt = $row->{cnt};
            last;
        }
        if ($cnt < 1) {
            print("INFO: pid $pid not found in $this_table\n");
        } else {
            my $cmd = "DELETE FROM $this_table WHERE pid = ?";
            if ($opt_confirm) {
                my $sth_update = $DBH_UPDATE->prepare($cmd);
                $sth_update->execute($pid)
                  or die "ERROR: problem deleting $pid from $this_table"
                  . "$DBH::errstr\n";
                print("INFO: $pid deleted from $this_table\n");
            } else {
                print("Proposing: Use PID $pid in SQL: $cmd\n");
            }
        }
    }

    return;
}

##############################################################################
# Main Routine
##############################################################################

# -- get options
GetOptions(
    'confirm' => \$opt_confirm,
    'debug'   => \$opt_debug,
    'end=i'   => \$opt_end,
    'help'    => \$opt_help,
    'lot=s'   => \$opt_lot,
    'manual'  => \$opt_manual,
    'start=i' => \$opt_start
);

if ($opt_debug) {
    print("DEBUG: Debugging started.");
}

# help the poor souls out
if ($opt_manual) {
    pod2usage(-verbose => 2);
}
if (scalar(@ARGV) == 0 || $ARGV[0] eq 'help') {
    $opt_help = 1;
}
if ($opt_help) {
    pod2usage(-verbose => 0);
}

# Validate input
#  If a start is given there must be an end
#  At least a start-end or lot must be given
if (!$opt_end && !$opt_start && !$opt_lot) {
    print("ERROR: start-end or lot must be specified\n");
    pod2usage(-verbose => 0);
}
if (($opt_start && !$opt_end) || (!$opt_start && $opt_end)) {
    print("ERROR: both start and end must be specified\n");
    pod2usage(-verbose => 0);
}

my $id      = shift;
my %id_list = get_id_list();
if (!$id_list{$id}) {
    print("ERROR: unknown ID $id\n");
    print("INFO: Valid IDs:\n");
    for my $i (sort keys %id_list) {
        print("    $i\n");
    }
    exit 1;
}
my $ring_conf = "/etc/rings/${id}.conf";
if ($opt_debug) {
    print("ring_conf = $ring_conf\n");
}
get_config($ring_conf);
if ($opt_debug) {
    $CONF->debug($opt_debug);
}

if ($opt_debug) {
    $CONF->debug($opt_debug);
}
if ($CONF->debug) {
    dbg("Initialize timer.");
}

# -- Open up connections to the MySQL data
db_connect();

my @pid_list = get_pid_list();
my @id_list  = get_id_list();
if (scalar(@id_list) < 1) {
    print("INFO: nothing to do, exiting\n");
    exit;
}

for my $pid (@pid_list) {
    print("\n");
    print("Processing picture $pid\n");
    ring_delete_picture($pid);
    db_delete_picture($pid);
}

db_disconnect();

exit;

__END__

=head1 NAME

ring-delete - bulk delete ring entries

=head1 SYNOPSIS

ring-delete <ring id> [--start=<start pid> --end=<end pid>]
[--lot=<picture lot>] [--confirm] [--debug] [--help] [--manual]

=head1 DESCRIPTION

This script can be used to bulk delete ring entries.  The script
deletes both the database entries for the selected range and any image
files.  Either start/end or lot must be specifed.  Both start/end
and lot maybe specified.

=head1 OPTIONS AND ARGUMENTS

=over 4

=item --confirm

Actually delete rings entries.  The default is to show what will be
deleted without performing any changes.

=item --start=pid

The first picture id to delete.  If specified then --end must also
be specified.

=item --end=pid

The last picture id to delete.  If specified then --start must also
be specified.

=item --lot=picture_lot

The picture lot to delete.  All pictures in the lot will be deleted
unless --start and --end are specified.

=item --help

Displays help text.

=item --manual

Displays more complete help text.

=item --debug

Turns on debugging displays.

=back

