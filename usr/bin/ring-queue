#!/usr/bin/perl
#
# ring-queue -- remctl script display ring queue status
#
# Written by Bill MacAllister <bill@ca-zephyr.org>
# Copyright (c) 2024-2026 Bill MacAllister <bill@ca-zephyr.org>

use strict;
use DBI;
use Getopt::Long;
use Pod::Usage;
use Rings::Common;

my $opt_actionclear;
my $opt_debug;
my $opt_help;
my $opt_manual;
my $opt_update;
my $opt_uploadclear;

##############################################################################
# Subroutines
##############################################################################

# ------------------------------------------------------------------------
# Display action queue entries

sub display_action_queue {
    print("\n");
    print("Action Queue Status:\n");
    my $sel = 'select * from picture_action_queue';
    dbg($sel) if $opt_debug;
    my $sth = $DBH->prepare($sel);
    $sth->execute();
    if ($sth->err) {
        sql_die($sel, $sth->err, $sth->errstr);
    }

    my $cnt = 0;
    printf("%7s %-16s %-16s %s\n", 'PID',   'Action', 'Status', 'Errors');
    printf("%7s %-16s %-16s %s\n", '-' x 7, '-' x 16, '-' x 16, '-' x 16);
    while (my $row = $sth->fetchrow_hashref('NAME_lc')) {
        printf(
            "%7d %-16s %-16s %s\n",
            $row->{pid},
            $row->{action},
            $row->{status},
            $row->{error_text}
        );
        $cnt++;
    }
    print("Action queue entries: $cnt\n");
    return;
}

# ------------------------------------------------------------------------
# Display upload queue entries

sub display_upload_queue {
    print("\n");
    print("Upload Queue Status:\n");
    my $sel = "select * from picture_upload_queue";
    dbg($sel) if $opt_debug;
    my $sth = $DBH->prepare($sel);
    $sth->execute();
    if ($sth->err) {
        sql_die($sel, $sth->err, $sth->errstr);
    }

    my $cnt = 0;
    printf("%-32s %-16s %s\n", 'Path',   'Status', 'Errors');
    printf("%-32s %-16s %s\n", '-' x 32, '-' x 16, '-' x 16);
    while (my $row = $sth->fetchrow_hashref('NAME_lc')) {
        printf(
            "%-32s %-16s %s\n",
            $row->{path},
            $row->{status},
            $row->{error_text}
        );
        $cnt++;
    }
    print("Upload queue entries: $cnt\n");
    return;
}

# ------------------------------------------------------------------------
# Clear action queue entries

sub clear_action_entries {
    print("\n");
    print("Clear Action Queue Status: $opt_actionclear\n");

    my $sel = 'SELECT * FROM picture_action_queue WHERE status = ?';
    dbg($sel) if $opt_debug;
    my $sth = $DBH->prepare($sel);
    $sth->execute($opt_actionclear);
    if ($sth->err) {
        sql_die($sel, $sth->err, $sth->errstr);
    }

    my $cnt = 0;
    if ($opt_update) {
        print("Deleting action queue entries:\n");
    } else {
        print("Proposing to delete action queue entries:\n");
    }
    while (my $row = $sth->fetchrow_hashref('NAME_lc')) {
        print('PID: ' . $row->{pid} . "\n");
        $cnt++;
    }

    if ($opt_update) {
        my $cmd = 'DELETE FROM picture_action_queue WHERE status = ?';
        dbg($cmd) if $opt_debug;
        my $sth = $DBH->prepare($cmd);
        $sth->execute($opt_actionclear);
        if ($sth->err) {
            sql_die($sel, $sth->err, $sth->errstr);
        }
        print("Action queue entries deleted: $cnt\n");
    } else {
        print("Action queue entries to delete: $cnt\n");
    }

    return;
}

# ------------------------------------------------------------------------
# Clear upload queue entries

sub clear_upload_entries {
    print("\n");
    print("Clear Upload Queue Status: $opt_uploadclear\n");
    my $sel = 'SELECT * FROM picture_upload_queue WHERE status=?';
    dbg($sel) if $opt_debug;
    my $sth = $DBH->prepare($sel);
    $sth->execute($opt_uploadclear);
    if ($sth->err) {
        sql_die($sel, $sth->err, $sth->errstr);
    }

    my $cnt = 0;
    if ($opt_update) {
        print("Deleting upload queue entries:\n");
    } else {
        print("Proposing to delete upload queue entries:\n");
    }
    while (my $row = $sth->fetchrow_hashref('NAME_lc')) {
        print('Path: ' . $row->{path} . "\n");
        $cnt++;
    }

    if ($opt_update) {
        my $cmd = 'DELETE FROM picture_upload_queue WHERE status=?';
        dbg($cmd) if $opt_debug;
        my $sth = $DBH->prepare($cmd);
        $sth->execute($opt_uploadclear);
        if ($sth->err) {
            sql_die($sel, $sth->err, $sth->errstr);
        }
        print("Upload queue entries deleted: $cnt\n");
    } else {
        print("Upload queue entries to delete: $cnt\n");
    }

    return;
}
##############################################################################
# Main routine
##############################################################################

# -- get options
GetOptions(
    'actionclear=s' => \$opt_actionclear,
    'debug'         => \$opt_debug,
    'help'          => \$opt_help,
    'manual'        => \$opt_manual,
    'update'        => \$opt_update,
    'uploadclear=s' => \$opt_uploadclear,
) or die("Invalid optioni\n");

if ($opt_debug) {
    print("DEBUG: output started\n");
}

# help the poor souls out
if ($opt_manual) {
    pod2usage(-verbose => 2);
}
if (scalar(@ARGV) == 0 || $ARGV[0] eq 'help') {
    $opt_help = 1;
}
if ($opt_help) {
    pod2usage(-verbose => 0);
}

my $id = shift;
dbg("id = $id\n") if $opt_debug;

my %id_list = get_id_list();
if (!$id_list{$id}) {
    print("ERROR: unknown ID $id\n");
    print("INFO: Valid IDs:\n");
    for my $i (sort keys %id_list) {
        print("    $i\n");
    }
    exit 1;
}
my $ring_conf = "/etc/rings/${id}.conf";
if ($opt_debug) {
    print("ring_conf = $ring_conf\n");
}
get_config($ring_conf);

db_connect();

if ($opt_actionclear || $opt_uploadclear) {
    if ($opt_actionclear) {
        clear_action_entries();
    }
    if ($opt_uploadclear) {
        clear_upload_entries();
    }
} else {
    display_action_queue();
    display_upload_queue();
}

exit;

__END__

=head1 NAME

ring-queue - display the rings processing queue status

=head1 SYNOPSIS

ring-queue <ring id> [--actionclear[=<status>]]
[--uploadclear[=<status>]] [--update] [--help] [--manual] [--debug]

=head1 DESCRIPTION

This script queues the rings database displaying processing queue
entries.  The script can be used to clear error reports from the
processing queue tables.

=head1 ARGUMENTS

=over 4

=item <ring id>

Display the processing queue status for the <ring id> ring.

=back

=head1 OPTIONS

=over 4

=item --actionclear=<status>

Clear any queue entries from both the upload and action queues
with a matching status.  The default status is 'ERROR'.

=item --uploadclear=<status>

Clear any queue entries from both the upload and action queues
with a matching status.  The default status is 'ERROR'.

=item --update

Perform any delete actions requested.  The default is to display
what will be deleted.

=item --help

Display usage information.

=item --manual

Display the man page for this script.

=item --debug

Display the debugging messages.

=back

